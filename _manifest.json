{
  "manifest_version": 2,
  "version": "3.1.0",
  "name": "MaiMai DX 双源查分器",
  "description": "舞萌 DX 双源查分插件：diving-fish（水鱼）查分 + lxns（落雪）账号接入（OAuth/个人密钥/开发者密钥），支持 B50、个人成绩、热力图、趋势、历史、排行、年度回顾、收藏品、成绩同步上传、猜歌与运势",
  "author": {
    "name": "DeepSeek-V4",
    "url": "https://github.com/DeepSeek-V4-Pro"
  },
  "license": "GPL-3.0-or-later",
  "urls": {
    "repository": "https://github.com/DeepSeek-V4-Pro/maimaidx_prober",
    "homepage": "https://github.com/DeepSeek-V4-Pro/maimaidx_prober",
    "documentation": "https://github.com/DeepSeek-V4-Pro/maimaidx_prober",
    "issues": "https://github.com/DeepSeek-V4-Pro/maimaidx_prober/issues"
  },
  "host_application": {
    "min_version": "1.0.0",
    "max_version": "1.99.99"
  },
  "sdk": {
    "min_version": "2.0.0",
    "max_version": "2.99.99"
  },
  "dependencies": [
    {
      "type": "python_package",
      "name": "aiohttp",
      "version_spec": ">=3.8"
    },
    {
      "type": "python_package",
      "name": "playwright",
      "version_spec": ">=1.40"
    }
  ],
  "capabilities": [
    "send.text",
    "send.forward",
    "send.image",
    "config.get",
    "render.html2png"
  ],
  "i18n": {
    "default_locale": "zh-CN",
    "supported_locales": ["zh-CN"]
  },
  "id": "deepseek-v4-pro.maimaidx-prober"
}
